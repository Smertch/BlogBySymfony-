###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=ChangeMe_ChangeMe_ChangeMe_ChangeMe
APP_NAME=Symfony
APP_URL=http://localhost:1525
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Host port from docker-compose is 1527; inside containers Docker overrides this.
DATABASE_URL="postgresql://user:password@127.0.0.1:1527/blog?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
###< symfony/mailer ###

###> symfony/messenger (kafka) ###
# Kafka EXTERNAL listener (host) is on 1529. Inside containers Docker overrides this with kafka:9092.
MESSENGER_TRANSPORT_DSN="kafka://127.0.0.1:1529?topic=messages&group_id=blog&auto_offset_reset=earliest"
###< symfony/messenger (kafka) ###

###> dev/vardumper ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< dev/vardumper ###
