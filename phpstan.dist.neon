parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        - src/Kernel.php
    treatPhpDocTypesAsCertain: false
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: tests/console-application.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        # Doctrine "type mapping mismatch" warnings are a known limitation of
        # phpstan-doctrine: BIGINT identifiers are unavoidably nullable in PHP
        # (between instantiation and first flush), and JoinColumn(nullable=false)
        # associations must still be typed as nullable because Doctrine
        # hydrates them after construction. None of these reflect real bugs.
        - identifier: doctrine.columnType
          path: src/Entity/*.php
        - identifier: doctrine.associationType
          path: src/Entity/*.php
