{
    "name": "blog/blog-by-symfony",
    "description": "Blog application (Symfony port of the Laravel Blog).",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^3.8",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.2",
        "easycorp/easyadmin-bundle": "^5.3",
        "nelmio/api-doc-bundle": "^4.30",
        "scheb/2fa-bundle": "^7.6",
        "scheb/2fa-google-authenticator": "^7.6",
        "symfony/asset": "^7.1",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/expression-language": "^7.1",
        "symfony/flex": "^2.4",
        "symfony/form": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/intl": "^7.1",
        "symfony/mailer": "^7.1",
        "symfony/messenger": "^7.1",
        "symfony/mime": "^7.1",
        "symfony/monolog-bundle": "^3.10",
        "symfony/process": "^7.1",
        "symfony/rate-limiter": "^7.1",
        "symfony/runtime": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/string": "^7.1",
        "symfony/translation": "^7.1",
        "symfony/twig-bundle": "^7.1",
        "symfony/validator": "^7.1",
        "symfony/yaml": "^7.1",
        "twig/extra-bundle": "^3.10",
        "twig/intl-extra": "^3.10",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.5",
        "phpstan/phpstan-symfony": "^1.4",
        "phpunit/phpunit": "^11.3",
        "symfony/browser-kit": "^7.1",
        "symfony/css-selector": "^7.1",
        "symfony/debug-bundle": "^7.1",
        "symfony/maker-bundle": "^1.61",
        "symfony/phpunit-bridge": "^7.1",
        "symfony/stopwatch": "^7.1",
        "symfony/web-profiler-bundle": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "suggest": {
        "ext-rdkafka": "Required for the custom Kafka Messenger transport (App\\Messenger\\Transport\\Kafka)",
        "ext-pgsql": "Required for the native PostgreSQL driver (alternative to pdo_pgsql)"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs:check": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs:fix": "php-cs-fixer fix --ansi",
        "phpstan": "phpstan analyse --ansi --memory-limit=512M",
        "lint": [
            "@php bin/console lint:twig templates --ansi",
            "@php bin/console lint:yaml config translations --parse-tags --ansi",
            "@php bin/console lint:container --ansi"
        ],
        "test": "phpunit --colors=always",
        "ci": [
            "@composer validate --no-check-publish",
            "@lint",
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^7.1"
        }
    }
}
