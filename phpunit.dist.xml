<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/.phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="APP_DEBUG" value="0" force="true" />
        <server name="APP_SECRET" value="ci-test-secret" force="true" />
        <server name="APP_NAME" value="Symfony" force="true" />
        <server name="APP_URL" value="http://localhost" force="true" />
        <server name="APP_LOCALE" value="en" force="true" />
        <server name="APP_FALLBACK_LOCALE" value="en" force="true" />
        <server name="MAIL_FROM_ADDRESS" value="hello@example.com" force="true" />
        <server name="MAIL_FROM_NAME" value="Blog" force="true" />
        <server name="MAILER_DSN" value="null://null" force="true" />
        <server name="MESSENGER_TRANSPORT_DSN" value="in-memory://" force="true" />
        <server name="DATABASE_URL" value="postgresql://user:password@127.0.0.1:5432/blog_test?serverVersion=16&amp;charset=utf8" force="false" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="SYMFONY_DEPRECATIONS_HELPER" value="999999" />
        <server name="SYMFONY_PHPUNIT_REMOVE" value="" />
        <server name="SYMFONY_PHPUNIT_VERSION" value="11.3" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
