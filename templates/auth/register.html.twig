{% extends 'layouts/auth.html.twig' %}

{% block content %}
    <div id="registerForm" class="form-wrapper">
        {% set form_errors = [] %}
        {% if form.vars.errors|length %}
            {% for e in form.vars.errors %}{% set form_errors = form_errors|merge([e.message]) %}{% endfor %}
        {% endif %}
        {% for child in form.children %}
            {% for e in child.vars.errors %}{% set form_errors = form_errors|merge([(child.vars.label ?: child.vars.name) ~ ': ' ~ e.message]) %}{% endfor %}
        {% endfor %}
        {% include 'components/_alert.html.twig' with { errors_bag: form_errors } %}

        <form action="{{ path('register.store') }}" method="post" novalidate>
            <input type="hidden" name="{{ form.vars.full_name }}[_token]" value="{{ csrf_token('register') }}">

            <div class="form-title">
                <i class="fas fa-seedling"></i> {{ ui('register.title') }}
            </div>
            <div class="mb-4 input-icon-wrapper">
                <i class="fas fa-user"></i>
                <input type="text" class="form-control" name="{{ form.name.vars.full_name }}" placeholder="{{ ui('register.username_ph') }}" required>
            </div>
            <div class="mb-4 input-icon-wrapper">
                <i class="fas fa-envelope"></i>
                <input type="email" class="form-control" name="{{ form.email.vars.full_name }}" placeholder="{{ ui('register.email_ph') }}" required>
            </div>
            <div class="mb-4 input-icon-wrapper input-password-wrapper">
                <i class="fas fa-lock"></i>
                <input
                    id="password"
                    type="password"
                    class="form-control"
                    name="{{ form.password.first.vars.full_name }}"
                    placeholder="{{ ui('register.password_ph') }}"
                    autocomplete="new-password"
                    required
                >
                <button
                    type="button"
                    class="password-toggle"
                    data-target="password"
                    aria-label="{{ ui('login.show_password') }}"
                    aria-controls="password"
                    title="{{ ui('login.show_password') }}"
                ><i class="fas fa-eye" aria-hidden="true"></i></button>
            </div>
            <div id="password-length-error" class="text-danger small mt-1 d-none"></div>

            <div class="mb-4 input-icon-wrapper input-password-wrapper">
                <i class="fas fa-lock"></i>
                <input
                    id="password_confirmation"
                    type="password"
                    class="form-control"
                    name="{{ form.password.second.vars.full_name }}"
                    placeholder="{{ ui('register.confirm_ph') }}"
                    autocomplete="new-password"
                    required
                >
                <button
                    type="button"
                    class="password-toggle"
                    data-target="password_confirmation"
                    aria-label="{{ ui('login.show_password') }}"
                    aria-controls="password_confirmation"
                    title="{{ ui('login.show_password') }}"
                ><i class="fas fa-eye" aria-hidden="true"></i></button>
            </div>
            <div id="password-match-error" class="text-danger small mt-1 d-none"></div>

            <div class="checkbox-row">
                <input type="checkbox" id="agree">
                <label for="agree">{{ ui('register.agree') }}</label>
            </div>

            <button type="submit" class="btn-submit">{{ ui('register.submit') }} <i class="fas fa-user-plus ms-2"></i></button>
        </form>

        <div class="social-login text-center">
            <p>{{ ui('register.or_signup') }}</p>
            <div class="social-icons">
                <a href="#" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                <a href="#" target="_blank" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            </div>
        </div>

        <div class="extra-links d-flex justify-content-between mt-4">
            <a href="{{ path('login') }}">{{ ui('register.already_have') }}</a>
            <a href="#">{{ ui('register.privacy') }}</a>
        </div>
    </div>
{% endblock %}
