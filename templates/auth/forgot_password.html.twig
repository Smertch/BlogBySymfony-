{% extends 'layouts/auth.html.twig' %}

{% block content %}
    <div id="forgotPasswordForm" class="form-wrapper">
        {% include 'components/_alert.html.twig' with { errors_bag: [] } %}

        <div class="form-title">
            <i class="fas fa-key"></i> Reset password
        </div>
        <p class="text-muted small mb-4">
            Enter your email and we'll send you a link to reset your password.
        </p>

        <form action="{{ path('password.email') }}" method="post">
            <input type="hidden" name="{{ form.vars.full_name }}[_token]" value="{{ csrf_token('forgot_password') }}">

            <div class="mb-4 input-icon-wrapper">
                <i class="fas fa-envelope"></i>
                <input
                    type="email"
                    class="form-control"
                    name="{{ form.email.vars.full_name }}"
                    value="{{ form.email.vars.value|default('') }}"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                >
            </div>

            <button type="submit" class="btn-submit">
                Send reset link <i class="fas fa-paper-plane ms-2"></i>
            </button>
        </form>

        <div class="extra-links d-flex justify-content-between mt-4">
            <a href="{{ path('login') }}">Back to login</a>
        </div>
    </div>
{% endblock %}
