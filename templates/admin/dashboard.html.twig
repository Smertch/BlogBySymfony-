{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ ui('admin.dashboard.title') }} | {{ ui('admin.nav.blog_admin') }}{% endblock title %}
{% block topbar_title %}{{ ui('admin.dashboard.title') }}{% endblock topbar_title %}

{% block topbar_actions %}
    <a class="btn btn-primary-green" href="{{ urls.posts_new }}">
        <i class="bi bi-plus-circle me-1"></i> {{ ui('admin.topbar.new_post') }}
    </a>
    <a class="btn btn-outline-green" href="{{ urls.users_new }}">
        <i class="bi bi-person-plus me-1"></i> {{ ui('admin.topbar.new_user') }}
    </a>
{% endblock topbar_actions %}

{% block admin_main %}
    <!-- First row: stats (2 cards as in the mockup) -->
    <div class="row g-4 mb-5">
        <!-- Users card -->
        <div class="col-md-6">
            <div class="card-dashboard card p-3 p-md-4 h-100">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <span class="text-secondary text-uppercase small fw-semibold">{{ ui('admin.dashboard.users_card') }}</span>
                        <div class="stat-number mt-1">{{ stats.users_total }}</div>
                        <div class="text-muted small mt-1">{{ ui('admin.dashboard.users_total_hint') }}</div>
                    </div>
                    <i class="bi bi-people fs-1" style="color: #cfe5cf;"></i>
                </div>
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <div class="badge-2fa">
                        <i class="bi bi-shield-lock me-1"></i>
                        {{ stats.users_with_2fa }} {{ ui('admin.dashboard.with_2fa') }}
                    </div>
                    <div class="badge-2fa">
                        <i class="bi bi-google me-1"></i>
                        {{ stats.users_with_2fa }} {{ ui('admin.dashboard.ga_confirmed') }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Posts card -->
        <div class="col-md-6">
            <div class="card-dashboard card p-3 p-md-4 h-100">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <span class="text-secondary text-uppercase small fw-semibold">{{ ui('admin.dashboard.posts_card') }}</span>
                        <div class="stat-number mt-1">{{ stats.posts_total }}</div>
                        <div class="text-muted small mt-1">{{ ui('admin.dashboard.posts_total_hint') }}</div>
                    </div>
                    <i class="bi bi-pencil-square fs-1" style="color: #cfe5cf;"></i>
                </div>
                <div class="mt-3">
                    <div class="green-badge-light">
                        <i class="bi bi-calendar-week me-1"></i>
                        {{ stats.posts_week }} {{ ui('admin.dashboard.new_this_week') }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: Latest posts (with View all and empty state) -->
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="card-dashboard card p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <h5 class="fw-semibold mb-0" style="color: #1e401e;">
                        <i class="bi bi-newspaper me-2"></i> {{ ui('admin.dashboard.latest_posts') }}
                    </h5>
                    <a href="{{ urls.posts_index }}" class="text-decoration-none small fw-semibold" style="color: #2c6e2f;">
                        {{ ui('admin.dashboard.view_all') }} <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
                <hr class="my-3">

                {% if recent_posts is empty %}
                    <!-- State: no posts -->
                    <div class="text-center py-5">
                        <div class="empty-state-icon mb-3">
                            <i class="bi bi-file-earmark-text fs-1"></i>
                        </div>
                        <h6 class="fw-semibold text-secondary">{{ ui('admin.dashboard.no_posts') }}</h6>
                        <p class="text-muted small">{{ ui('admin.dashboard.start_blog') }}</p>
                        <a href="{{ urls.posts_new }}" class="btn btn-primary-green mt-2">
                            <i class="bi bi-plus-lg me-1"></i> {{ ui('admin.dashboard.create_first_post') }}
                        </a>
                    </div>
                {% else %}
                    <ul class="list-group list-group-flush">
                        {% for post in recent_posts %}
                            <li class="list-group-item-borderless d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3 min-w-0">
                                    <i class="bi bi-file-earmark-text fs-4" style="color: #588b5b;"></i>
                                    <div class="min-w-0">
                                        <div class="fw-semibold text-truncate" style="color: #1e401e;">
                                            {{ post.title }}
                                        </div>
                                        <div class="small text-secondary">
                                            <i class="bi bi-person me-1"></i>
                                            {% if post.user %}{{ post.user.name }}{% else %}{{ ui('feed.unknown_author') }}{% endif %}
                                            <span class="mx-1">|</span>
                                            <i class="bi bi-clock me-1"></i>
                                            {{ post.createdAt|date('M j, Y') }}
                                        </div>
                                    </div>
                                </div>
                                <span class="green-badge-light">#{{ post.id }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Latest users (mockup-aligned table) -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card-dashboard card p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                    <h5 class="fw-semibold mb-0" style="color: #1e401e;">
                        <i class="bi bi-person-arms-up me-2"></i> Latest users
                    </h5>
                    <a href="{{ urls.users_index }}" class="text-decoration-none small fw-semibold" style="color: #2c6e2f;">
                        View all <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>

                {% if recent_users is empty %}
                    <div class="text-center py-5">
                        <div class="empty-state-icon mb-3">
                            <i class="bi bi-person-x fs-1"></i>
                        </div>
                        <h6 class="fw-semibold text-secondary">No users yet.</h6>
                        <a href="{{ urls.users_new }}" class="btn btn-primary-green mt-2">
                            <i class="bi bi-person-plus me-1"></i> Add the first user
                        </a>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light" style="background-color: #f3f9f3;">
                                <tr>
                                    <th scope="col">User</th>
                                    <th scope="col">Role</th>
                                    <th scope="col">2FA status</th>
                                    <th scope="col">Registered</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for u in recent_users %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-circle fs-5" style="color: #588b5b;"></i>
                                                <span class="fw-semibold">{{ u.name|default(u.email) }}</span>
                                                <span class="small text-secondary">{{ u.email }}</span>
                                            </div>
                                        </td>
                                        <td>
                                            {% if u.isAdmin %}
                                                <span class="role-pill role-pill--admin">Administrator</span>
                                            {% else %}
                                                <span class="role-pill">User</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if u.twoFactorConfirmedAt %}
                                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1 small"></i> Active
                                                </span>
                                            {% else %}
                                                <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">
                                                    Disabled
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td class="text-nowrap">{{ u.createdAt|date('M j, Y') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                <div class="text-center text-muted small mt-2 border-top pt-3">
                    <i class="bi bi-person-plus me-1"></i>
                    Total registered: <strong>{{ stats.users_total }}</strong>
                    {% if stats.users_total == 1 %}user{% else %}users{% endif %}
                    | with 2FA: <strong>{{ stats.users_with_2fa }}</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Optional analytics + quick actions section -->
    <div class="row mt-5 g-4">
        <div class="col-md-6">
            <div class="card-dashboard card p-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-chart-line fs-4" style="color: #2a682e;"></i>
                    <span class="fw-semibold">Latest activity</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between">
                    <span>Posts published (total)</span>
                    <span class="fw-bold">{{ stats.posts_total }}</span>
                </div>
                <div class="d-flex justify-content-between mt-2">
                    <span>Posts created (last 7 days)</span>
                    <span class="fw-bold">{{ stats.posts_week }}</span>
                </div>
                <div class="mt-3 small text-success bg-light p-2 rounded-3">
                    <i class="bi bi-info-circle-fill"></i>
                    New this week: {{ stats.posts_week }}
                    {% if stats.posts_week == 1 %}post{% else %}posts{% endif %} created in last 7 days.
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card-dashboard card p-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-envelope-paper fs-4" style="color: #2a682e;"></i>
                    <span class="fw-semibold">Quick actions</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-green" href="{{ urls.posts_new }}">
                        <i class="bi bi-pencil"></i> Write a post
                    </a>
                    <a class="btn btn-sm btn-outline-green" href="{{ urls.users_index }}">
                        <i class="bi bi-person-badge"></i> Manage users
                    </a>
                    <a class="btn btn-sm btn-outline-green" href="{{ path('home') }}">
                        <i class="bi bi-megaphone"></i> Visit site
                    </a>
                </div>
                <div class="mt-3 small text-secondary text-center">
                    Logged in as <strong>{{ dashboard_logged_in_as }}</strong>
                    <span class="text-muted"> | Green zone</span>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
