{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ ui('admin.posts.title') }} · {{ ui('admin.nav.blog_admin') }}{% endblock %}
{% block topbar_title %}{{ ui('admin.posts.title') }}{% endblock %}

{% block topbar_actions %}
    <a class="btn btn-primary-green" href="{{ urls.posts_new }}">
        <i class="bi bi-plus-circle me-1"></i> {{ ui('admin.posts.add') }}
    </a>
    <button type="button"
            class="btn btn-outline-danger-custom js-bulk-delete-trigger"
            disabled
            data-bs-toggle="modal"
            data-bs-target="#bulkDeleteModal">
        <i class="bi bi-trash3 me-1"></i> {{ ui('admin.posts.bulk_delete') }} <span class="js-bulk-count d-none ms-1">(0)</span>
    </button>
{% endblock %}

{% block admin_main %}
    {% include 'admin/_partials/flash_messages.html.twig' %}

    {% include 'admin/_partials/search_card.html.twig' with {
        action_url: urls.posts_index,
        query: q,
        query_placeholder: ui('admin.posts.search_ph'),
        total: total,
        hidden_fields: {},
        filter: null,
    } only %}

    <div class="card-dashboard card p-0 overflow-hidden">
        <form id="bulkSelectForm" method="post" action="{{ path('admin_posts_bulk_delete') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('bulk-delete-posts') }}">

            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" class="form-check-input select-all-checkbox"
                                       id="selectAllCheckbox" {{ posts is empty ? 'disabled' }}>
                            </th>
                            <th>{{ ui('admin.table.id') }}</th>
                            <th>{{ ui('admin.posts.table.title') }}</th>
                            <th>{{ ui('admin.posts.table.author') }}</th>
                            <th>{{ ui('admin.posts.table.status') }}</th>
                            <th>{{ ui('admin.posts.table.created') }}</th>
                            <th class="text-center">{{ ui('admin.table.actions') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if posts is empty %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="empty-state-icon mb-2">
                                        <i class="bi bi-journal-x"></i>
                                    </div>
                                    <h6 class="text-secondary">{{ ui('admin.posts.empty') }}</h6>
                                    <a href="{{ urls.posts_new }}" class="btn btn-outline-green mt-2">
                                        <i class="bi bi-plus-lg me-1"></i> {{ ui('admin.posts.create_first') }}
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            {% for post in posts %}
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input js-post-checkbox"
                                               name="ids[]" value="{{ post.id }}">
                                    </td>
                                    <td class="fw-semibold">{{ post.id }}</td>
                                    <td><strong>{{ post.title }}</strong></td>
                                    <td class="text-secondary small">
                                        {% if post.user %}
                                            <i class="bi bi-person me-1"></i>
                                            {{ post.user.name ?: post.user.email }}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="status-published">
                                            <i class="bi bi-check-circle-fill me-1"></i> {{ ui('admin.status.published') }}
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        {{ post.createdAt|date('M j, Y') }}
                                    </td>
                                    <td class="text-center action-icons">
                                        <a href="{{ edit_urls[post.id] }}" title="{{ ui('admin.action.edit_post') }}">
                                            <i class="bi bi-pencil-square me-3"></i>
                                        </a>
                                        <a href="#"
                                           title="{{ ui('admin.action.delete_post') }}"
                                           class="js-delete-trigger"
                                           data-bs-toggle="modal"
                                           data-bs-target="#confirmDeleteModal"
                                           data-entity-name="{{ post.title }}"
                                           data-action-url="{{ path('admin_posts_delete', { id: post.id }) }}"
                                           data-csrf-token="{{ csrf_token('delete-post-' ~ post.id) }}">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>

            {% include 'admin/_partials/pagination.html.twig' with {
                total: total,
                page: page,
                total_pages: total_pages,
                pagination_pages: pagination_pages,
                route: 'admin_posts_index',
                route_params: {
                    q: q,
                },
            } only %}
        </form>
    </div>

    {% include 'admin/_partials/delete_confirm_modal.html.twig' with {
        entity_label: "post",
    } only %}

    {# Bulk-delete confirmation modal — specific to the Posts page #}
    <div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 24px; border: 1px solid #f0d0d0;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-semibold" style="color: #b02a37;">Bulk delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="mb-2">
                        You are going to apply the "delete" action to
                        <strong class="js-bulk-count">0</strong> item(s).
                    </p>
                    <p class="text-danger small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        There is no undo for this operation.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="bulkProceedBtn">
                        Proceed
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock admin_main %}

{% block body_extra %}
    {% include 'admin/_partials/delete_trigger.html.twig' %}

    <script>
        // Posts table — select-all + bulk delete wiring.
        (function () {
            const form = document.getElementById('bulkSelectForm');
            const selectAll = document.getElementById('selectAllCheckbox');
            const checkboxes = document.querySelectorAll('.js-post-checkbox');
            const bulkBtn = document.querySelector('.js-bulk-delete-trigger');
            const counters = document.querySelectorAll('.js-bulk-count');
            const proceedBtn = document.getElementById('bulkProceedBtn');

            function refreshState() {
                const checked = form.querySelectorAll('.js-post-checkbox:checked').length;
                const total = checkboxes.length;
                bulkBtn.disabled = checked === 0;
                counters.forEach(function (el) {
                    el.textContent = el.classList.contains('d-none') || el.parentElement === bulkBtn
                        ? '(' + checked + ')'
                        : String(checked);
                });
                counters.forEach(function (el) {
                    if (el.parentElement === bulkBtn) {
                        el.classList.toggle('d-none', checked === 0);
                    }
                });
                if (selectAll) {
                    selectAll.checked = total > 0 && checked === total;
                    selectAll.indeterminate = checked > 0 && checked < total;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(function (cb) {
                        cb.checked = selectAll.checked;
                    });
                    refreshState();
                });
            }

            checkboxes.forEach(function (cb) {
                cb.addEventListener('change', refreshState);
            });

            if (proceedBtn) {
                proceedBtn.addEventListener('click', function () {
                    form.submit();
                });
            }

            refreshState();
        })();
    </script>
{% endblock %}
