{% extends 'admin/_layout.html.twig' %}

{% block title %}Users · Blog Admin{% endblock %}
{% block topbar_title %}Users{% endblock %}
{% block active_nav %}users{% endblock %}

{% block topbar_actions %}
    <a class="btn btn-primary-green" href="{{ urls.users_new }}">
        <i class="bi bi-person-plus me-1"></i> Add User
    </a>
{% endblock %}

{% block content %}
    {% include 'admin/_partials/flash_messages.html.twig' %}

    {% include 'admin/_partials/search_card.html.twig' with {
        action_url: urls.users_index,
        query: q,
        query_placeholder: 'Search by name or email...',
        total: total,
        hidden_fields: {},
        filter: {
            name: 'twofa',
            value: twofa,
            options: [
                { value: 'all',       label: 'All users' },
                { value: 'confirmed', label: '2FA confirmed' },
                { value: 'null',      label: '2FA not confirmed (Null)' },
            ],
        },
    } only %}

    <div class="card-dashboard card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-custom mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email address</th>
                        <th>2FA confirmed</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if users is empty %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No users found.
                            </td>
                        </tr>
                    {% else %}
                        {% for u in users %}
                            <tr>
                                <td class="fw-semibold">{{ u.id }}</td>
                                <td>{{ u.name ?: '—' }}</td>
                                <td>{{ u.email }}</td>
                                <td>
                                    {% if u.twoFactorConfirmedAt %}
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Confirmed
                                        </span>
                                    {% else %}
                                        <span class="badge-2fa-null">
                                            <i class="bi bi-dash-circle me-1"></i>
                                            Null
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-center action-icons">
                                    <a href="{{ edit_urls[u.id] }}" title="Edit user">
                                        <i class="bi bi-pencil-square me-3"></i>
                                    </a>
                                    <a href="#"
                                       title="Delete user"
                                       class="js-delete-trigger"
                                       data-bs-toggle="modal"
                                       data-bs-target="#confirmDeleteModal"
                                       data-entity-name="{{ u.name ?: u.email }}"
                                       data-action-url="{{ path('admin_users_delete', { id: u.id }) }}"
                                       data-csrf-token="{{ csrf_token('delete-user-' ~ u.id) }}">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>

        {% include 'admin/_partials/pagination.html.twig' with {
            total: total,
            page: page,
            total_pages: total_pages,
            route: 'admin_users_index',
            route_params: {
                q: q,
                twofa: twofa,
            },
        } only %}
    </div>

    <div class="mt-3 text-center text-muted small">
        <i class="bi bi-database"></i>
        Showing all users · Access management
    </div>

    {% include 'admin/_partials/delete_confirm_modal.html.twig' with { entity_label: 'user' } only %}
{% endblock %}

{% block body_extra %}
    {% include 'admin/_partials/delete_trigger.html.twig' %}
{% endblock %}
