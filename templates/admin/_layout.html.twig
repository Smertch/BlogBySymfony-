<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>{% block title %}Blog Admin{% endblock %}</title>

    {# Bootstrap 5 + Bootstrap Icons + Inter font #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

    <style>
        * { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; }

        body {
            background-color: #f0f5f0; /* very light greenish background */
        }

        /* Custom green-on-white accents */
        :root {
            --primary-green: #2c6e2f;
            --primary-light: #e9f5e9;
            --primary-soft: #d4e9d4;
            --border-green: #c2dbc2;
            --text-dark: #1e2a1e;
        }

        .sidebar {
            background-color: white;
            border-right: 1px solid var(--border-green);
            box-shadow: 0 0 12px rgba(0, 30, 0, 0.03);
            min-height: 100vh;
        }

        .sidebar .nav-link {
            color: #2c4a2c;
            font-weight: 500;
            border-radius: 12px;
            padding: 10px 16px;
            margin-bottom: 6px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .sidebar .nav-link:hover {
            background-color: var(--primary-light);
            color: #1b4d1b;
        }

        .sidebar .nav-link.active {
            background-color: var(--primary-green);
            color: white;
            box-shadow: 0 4px 8px rgba(44, 110, 47, 0.2);
        }

        .sidebar .nav-link i {
            width: 24px;
            margin-right: 10px;
            font-size: 1.2rem;
        }

        .sidebar .nav-section {
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 0.05em;
            color: #6b8a6d;
            padding: 12px 16px 6px;
            font-weight: 600;
        }

        .card-dashboard {
            border: 1px solid rgba(60, 110, 60, 0.1);
            border-radius: 24px;
            background: white;
            box-shadow: 0 6px 14px rgba(0, 20, 0, 0.03);
            transition: transform 0.1s ease;
        }

        .stat-number {
            font-size: 2.3rem;
            font-weight: 700;
            color: #1d4d1f;
            letter-spacing: -0.02em;
        }

        .badge-2fa {
            background-color: #eef5ee;
            color: #2a6b2e;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: 40px;
        }

        .btn-outline-green {
            border: 1px solid var(--primary-green);
            color: var(--primary-green);
            background: white;
            border-radius: 40px;
            padding: 6px 16px;
            font-weight: 500;
            transition: 0.2s;
            text-decoration: none;
        }

        .btn-outline-green:hover {
            background-color: var(--primary-green);
            color: white;
            border-color: var(--primary-green);
        }

        .btn-primary-green {
            background-color: var(--primary-green);
            border: none;
            border-radius: 40px;
            padding: 6px 18px;
            font-weight: 500;
            color: white;
            text-decoration: none;
        }

        .btn-primary-green:hover {
            background-color: #215f24;
            color: white;
        }

        .topbar {
            background: white;
            border-bottom: 1px solid var(--border-green);
            padding: 12px 24px;
            border-radius: 0;
        }

        .avatar-circle {
            background-color: var(--primary-light);
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: var(--primary-green);
            font-weight: 600;
        }

        .empty-state-icon {
            font-size: 2.8rem;
            color: #bdd8bd;
        }

        .list-group-item-borderless {
            border: none;
            border-bottom: 1px solid #eef2ee;
            padding: 14px 0;
        }

        .footer-link {
            color: #477a49;
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .sidebar { min-height: auto; }
        }

        .green-badge-light {
            background: #e3f3e3;
            color: #1f6822;
            border-radius: 30px;
            padding: 5px 12px;
            font-size: 0.8rem;
        }

        .role-pill {
            background: #f1f7f1;
            color: #2c6e2f;
            border-radius: 30px;
            padding: 3px 10px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .role-pill--admin {
            background: #fff1ef;
            color: #b14338;
        }

        /* Tables shared between admin list views (users, posts, ...) */
        .table-custom {
            border-collapse: separate;
            border-spacing: 0;
        }

        .table-custom thead th {
            background-color: #f8faf8;
            border-bottom: 2px solid var(--border-green);
            color: #1e3a1e;
            font-weight: 600;
            padding: 14px 12px;
        }

        .table-custom tbody td {
            padding: 14px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #e9ece9;
        }

        /* Pill-shaped search input with leading icon */
        .search-wrapper {
            position: relative;
        }

        .search-wrapper > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #8bbf8e;
        }

        .search-wrapper input {
            padding-left: 42px;
            border-radius: 50px;
            border: 1px solid var(--border-green);
            background-color: white;
        }

        /* Pagination */
        .pagination-custom .page-item.active .page-link {
            background-color: var(--primary-green);
            border-color: var(--primary-green);
            color: white;
        }

        .pagination-custom .page-link {
            color: var(--primary-green);
            border-radius: 8px;
            margin: 0 3px;
        }

        /* Row-action icons in admin tables (edit / delete / ...) */
        .action-icons a,
        .action-icons button {
            border: 0;
            background: transparent;
            padding: 0;
            color: inherit;
        }

        .action-icons i {
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.2s;
            color: #5a8f5c;
        }

        .action-icons i:hover {
            color: var(--primary-green);
            transform: scale(1.05);
        }

        .action-icons i.bi-trash3:hover {
            color: #dc3545;
        }

        .select-all-checkbox {
            cursor: pointer;
        }

        /* Danger outline pill button (used for "Delete selected") */
        .btn-outline-danger-custom {
            border: 1px solid #dc3545;
            color: #dc3545;
            background: white;
            border-radius: 40px;
            padding: 6px 16px;
            font-weight: 500;
            transition: 0.2s;
        }

        .btn-outline-danger-custom:hover {
            background-color: #dc3545;
            color: white;
        }

        .btn-outline-danger-custom:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        /* Status badges (published / draft) */
        .status-published {
            background-color: #e3f5e3;
            color: #2c6e2f;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-draft {
            background-color: #fef5e7;
            color: #e68a2e;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* Light "Null" / inactive 2FA pill */
        .badge-2fa-null {
            background-color: #f3f4f3;
            color: #6c757d;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }
    </style>

    {% block head_extra %}{% endblock %}
</head>
<body>

<div class="container-fluid px-0">
    <div class="row g-0">
        {# SIDEBAR (left navigation) #}
        <div class="col-md-3 col-lg-2 sidebar p-4">
            <div class="d-flex align-items-center mb-4 pb-2">
                <i class="bi bi-journal-bookmark-fill fs-3" style="color: #2c6e2f;"></i>
                <span class="fs-4 fw-semibold ms-2" style="color: #1b4c1b;">Blog Admin</span>
            </div>

            <div class="mb-4 pb-1 border-bottom border-success-subtle">
                <div class="d-flex align-items-center">
                    <div class="avatar-circle me-2">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div>
                        <div class="fw-semibold small text-secondary">Logged in as</div>
                        <div class="fw-bold" style="color: #1f4f21;">
                            {{ app.user ? app.user.userIdentifier : 'guest' }}
                        </div>
                    </div>
                </div>
            </div>

            {% set active_nav = block('active_nav') is defined ? block('active_nav') : 'dashboard' %}

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link {{ active_nav == 'dashboard' ? 'active' }}" href="{{ path('admin') }}">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_nav == 'home' ? 'active' }}" href="{{ path('home') }}">
                        <i class="bi bi-house-door"></i> Home
                    </a>
                </li>

                <li class="nav-section">Content</li>

                <li class="nav-item">
                    <a class="nav-link {{ active_nav == 'users' ? 'active' }}" href="{{ nav_urls.users_index|default('#') }}">
                        <i class="bi bi-people"></i> Users
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_nav == 'posts' ? 'active' }}" href="{{ nav_urls.posts_index|default('#') }}">
                        <i class="bi bi-pencil-square"></i> Posts
                    </a>
                </li>
            </ul>

            <hr class="my-4" style="color: #cfe2cf;">
            <div class="small text-secondary mt-2">
                <i class="bi bi-shield-check me-1"></i> v2.0 · Green Panel
            </div>
        </div>

        {# MAIN AREA (right content) #}
        <div class="col-md-9 col-lg-10" style="background-color: #f8fbf8 !important;">
            {# Top bar with greeting and quick actions #}
            <div class="topbar d-flex flex-wrap justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-grid-3x3-gap-fill fs-4" style="color: #2c6e2f;"></i>
                    <h5 class="mb-0 fw-semibold" style="color: #1c441e;">
                        {% block topbar_title %}Dashboard{% endblock %}
                    </h5>
                    {% if app.user %}
                        <span class="badge bg-white text-dark border px-3 py-1 rounded-pill">
                            {{ app.user.userIdentifier }}
                        </span>
                    {% endif %}
                </div>
                <div class="d-flex gap-2 mt-2 mt-sm-0">
                    {% block topbar_actions %}{% endblock %}
                </div>
            </div>

            <div class="p-4 p-md-5 pt-4">
                {% block content %}{% endblock %}

                {# footer note (optional) #}
                <footer class="mt-5 pt-3 text-center small text-muted border-top border-light">
                    <i class="bi bi-dot"></i> Blog Admin Panel — green-on-white theme
                    <i class="bi bi-dot"></i> Bootstrap 5
                    <a href="{{ path('admin') }}" class="footer-link">Dashboard</a> ·
                    <a href="{{ path('home') }}" class="footer-link">Home</a>
                </footer>
            </div>
        </div>
    </div>
</div>

{# Bootstrap JS Bundle for interactive components #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Keep the active sidebar link in sync on click (visual only).
    const navLinks = document.querySelectorAll('.sidebar .nav-link');
    navLinks.forEach(link => {
        link.addEventListener('click', function () {
            navLinks.forEach(l => l.classList.remove('active'));
            this.classList.add('active');
        });
    });
</script>

{% block body_extra %}{% endblock %}
</body>
</html>
