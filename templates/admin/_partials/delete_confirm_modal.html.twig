{#
    Shared single-item delete confirmation modal.

    The modal renders an empty form whose `action` and CSRF `_token` are
    populated by `delete_trigger.js` when a row's trash icon is clicked.

    Required:
      entity_label – human label used in the question ("user", "post", ...)

    Trigger links must have:
      class                       js-delete-trigger
      data-bs-toggle="modal"
      data-bs-target="#confirmDeleteModal"
      data-action-url="..."       (form action URL)
      data-csrf-token="..."       (CSRF token value)
      data-entity-name="..."      (label shown in the confirmation text)
#}
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" id="deleteEntityForm" class="modal-content"
              style="border-radius: 24px; border: 1px solid #d9eed9;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold" id="confirmDeleteLabel" style="color: #1e4a1e;">
                    Confirm action
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-0">
                    Are you sure you want to delete {{ entity_label }}
                    <strong id="confirmDeleteEntityName">—</strong>?
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <input type="hidden" name="_token" id="deleteEntityCsrf" value="">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary-green rounded-pill px-4">
                    Confirm
                </button>
            </div>
        </form>
    </div>
</div>
