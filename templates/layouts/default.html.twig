<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Navbar</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                {% if app.user is null %}
                    <li class="nav-item">
                        <a class="nav-link registration" href="{{ path('register') }}">Registration</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link login" href="{{ path('login') }}">Login</a>
                    </li>
                {% endif %}
                <li class="nav-item">
                    <a class="nav-link create post">Create post</a>
                </li>
            </ul>
            {% if app.user %}
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item d-flex align-items-center gap-2 py-1 py-lg-0">
                        {% if app.user.isAdmin() %}
                            <a href="{{ path('admin') }}" class="btn btn-primary btn-sm px-3">Admin</a>
                        {% endif %}
                        <form method="POST" action="{{ path('logout') }}" class="m-0">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="btn btn-success btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            {% endif %}
        </div>
    </div>
</nav>

{% block content %}{% endblock %}
</body>
</html>
