<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ 'password_reset_subject'|trans({}, 'auth') }}</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif; background: #f4f6f8; padding: 24px;">
    <div style="max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 32px; border: 1px solid #e5e7eb;">
        <h1 style="margin: 0 0 16px; font-size: 22px; color: #0f172a;">Reset your password</h1>

        <p style="margin: 0 0 16px; color: #334155; line-height: 1.6;">
            You are receiving this email because we received a password reset request for your account.
        </p>

        <p style="text-align: center; margin: 24px 0;">
            <a href="{{ reset_url }}"
               style="display: inline-block; padding: 12px 24px; background: #1e9b6e; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">
                Reset password
            </a>
        </p>

        <p style="margin: 0; color: #64748b; font-size: 14px;">
            If you did not request a password reset, no further action is required.
        </p>
    </div>
</body>
</html>
